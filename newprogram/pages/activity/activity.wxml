<view class="page">
  <view class="header">
    <view class="header-top">
      <text class="header-title">低碳活动</text>
    </view>

    <view class="tabs">
      <view class="tab-item {{activeTab === item.id ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="id" bindtap="switchTab" data-tab="{{item.id}}">
        <text>{{item.name}}</text>
        <text class="tab-badge" wx:if="{{item.id === 'joined' && joinedActivities.length > 0}}">{{joinedActivities.length}}</text>
      </view>
    </view>
  </view>

  <!-- 全部活动/进行中 -->
  <view class="activities-list" wx:if="{{activeTab !== 'joined'}}">
    <view class="activity-card" wx:for="{{filteredActivities}}" wx:key="id">
      <view class="card-image" wx:if="{{item.imageUrl}}" style="background-image: url('{{item.imageUrl}}')">
        <view class="card-badge {{item.statusText === '进行中' ? 'ongoing' : item.statusText === '未开始' ? 'upcoming' : 'ended'}}">{{item.statusText}}</view>
      </view>
      <view class="card-content">
        <text class="card-title">{{item.title}}</text>
        <text class="card-desc" wx:if="{{item.description}}">{{item.description.length > 50 ? item.description.substring(0, 50) + '...' : item.description}}</text>
        <view class="card-meta">
          <text class="meta-item">📅 {{item.dateRange}}</text>
          <text class="meta-points">🏆 {{item.rewardPoints || 0}} 积分</text>
        </view>
        <view class="card-footer">
          <button class="btn-join" wx:if="{{item.statusText === '进行中' && !item.isJoined}}" bindtap="joinActivity" data-id="{{item.id}}">立即报名</button>
          <view class="joined-tag" wx:elif="{{item.isJoined}}">
            <text>已报名</text>
          </view>
          <text class="status-text" wx:else>{{item.statusText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{filteredActivities.length === 0}}" class="empty-tip">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无活动</text>
    </view>
  </view>

  <!-- 已参与活动 -->
  <view class="activities-list" wx:if="{{activeTab === 'joined'}}">
    <view class="joined-card" wx:for="{{joinedActivities}}" wx:key="id">
      <view class="joined-header">
        <text class="joined-title">{{item.activityTitle || '活动'}}</text>
        <view class="joined-status {{item.statusClass}}">
          {{item.statusText}}
        </view>
      </view>
      <view class="joined-meta">
        <text class="meta-item">参与时间: {{item.createdAt}}</text>
        <text class="meta-item" wx:if="{{item.reviewComment}}">审核意见: {{item.reviewComment}}</text>
      </view>
      <view class="joined-footer" wx:if="{{item.status === 0}}">
        <button class="btn-proof" bindtap="submitProof" data-participation-id="{{item.id}}" data-activity-id="{{item.activityId}}">提交凭证</button>
      </view>
      <view class="joined-footer" wx:if="{{item.status === 2}}">
        <text class="reject-hint">请重新报名或联系管理员</text>
      </view>
    </view>

    <view wx:if="{{joinedActivities.length === 0}}" class="empty-tip">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无参与记录</text>
    </view>
  </view>
</view>
