<view class="page">
  <view class="header">
    <text class="header-title">参与的活动</text>
    <button class="btn-browse" bindtap="goActivityList">浏览活动</button>
  </view>

  <view class="activities-list" wx:if="{{activities.length > 0}}">
    <view class="activity-item" wx:for="{{activities}}" wx:key="id">
      <view class="activity-info">
        <text class="activity-title">{{item.activityTitle || '活动'}}</text>
        <text class="activity-time">参与时间: {{item.timeStr}}</text>
        <text class="activity-comment" wx:if="{{item.reviewComment}}">审核意见: {{item.reviewComment}}</text>
      </view>
      <view class="activity-right">
        <view class="activity-status {{item.statusClass}}">
          <text>{{item.statusText}}</text>
        </view>
        <text class="activity-points" wx:if="{{item.status === 1 && item.rewardPoints}}">+{{item.rewardPoints}} 积分</text>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{!loading && activities.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">还没有参与任何活动</text>
    <button class="btn-go" bindtap="goActivityList">去参与活动</button>
  </view>
</view>
