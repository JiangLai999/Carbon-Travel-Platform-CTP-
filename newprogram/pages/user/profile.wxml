<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="header-title">个人资料</text>
    <view class="header-right"></view>
  </view>

  <!-- 头像区域 -->
  <view class="avatar-section">
    <view class="avatar-wrapper" bindtap="chooseAvatar">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" wx:if="{{userInfo.avatar}}" />
      <view class="avatar-placeholder" wx:else>
        <text class="avatar-text">{{userInfo.nickname ? userInfo.nickname[0] : '我'}}</text>
      </view>
      <view class="avatar-edit">
        <text class="avatar-edit-icon">📷</text>
      </view>
    </view>
    <text class="avatar-tip">点击更换头像</text>
  </view>

  <!-- 基本信息表单 -->
  <view class="form-section">
    <view class="section-title">基本信息</view>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">用户编号</text>
        <text class="form-value disabled">{{userInfo.id || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <text class="form-value disabled">{{userInfo.phone || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input class="form-input" placeholder="请输入昵称" value="{{userInfo.nickname}}" bindinput="onInput" data-field="nickname" />
      </view>
      <view class="form-item">
        <text class="form-label">邮箱</text>
        <input class="form-input" placeholder="请输入邮箱" value="{{userInfo.email}}" bindinput="onInput" data-field="email" />
      </view>
    </view>
  </view>

  <!-- 实名认证 -->
  <view class="form-section">
    <view class="section-title">
      <text>实名认证</text>
      <text class="section-tip">{{userInfo.realName ? '已认证' : '未认证'}}</text>
    </view>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">真实姓名</text>
        <input class="form-input" placeholder="请输入真实姓名" value="{{userInfo.realName}}" bindinput="onInput" data-field="realName" />
      </view>
      <view class="form-item">
        <text class="form-label">身份证号</text>
        <input class="form-input" placeholder="请输入身份证号" value="{{userInfo.idCard}}" bindinput="onInput" data-field="idCard" type="idcard" maxlength="18" />
      </view>
    </view>
    <view class="auth-tip">
      <text class="auth-tip-icon">🔒</text>
      <text class="auth-tip-text">实名信息将用于活动参与和积分兑换，我们会严格保护您的隐私</text>
    </view>
  </view>

  <!-- 账户状态 -->
  <view class="form-section">
    <view class="section-title">账户状态</view>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">账户角色</text>
        <view class="form-tag {{userInfo.role === 'admin' ? 'admin' : 'user'}}">{{userInfo.role === 'admin' ? '管理员' : '普通用户'}}</view>
      </view>
      <view class="form-item">
        <text class="form-label">账户状态</text>
        <view class="form-tag {{userInfo.status === 1 ? 'active' : 'inactive'}}">{{userInfo.status === 1 ? '正常' : '已禁用'}}</view>
      </view>
      <view class="form-item">
        <text class="form-label">注册时间</text>
        <text class="form-value disabled">{{userInfo.createdAt || '-'}}</text>
      </view>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="form-section">
    <view class="section-title">
      <text>收货地址</text>
      <text class="section-link" bindtap="goAddressList">管理</text>
    </view>
    <view class="form-card" bindtap="goAddressList">
      <view class="address-entry">
        <text class="entry-icon">📍</text>
        <text class="entry-text">管理收货地址</text>
        <text class="entry-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-section">
    <button class="btn-save" bindtap="saveProfile" loading="{{loading}}" disabled="{{loading}}" style="height: 41rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">保存修改</button>
  </view>

  <view class="bottom-safe"></view>
</view>
