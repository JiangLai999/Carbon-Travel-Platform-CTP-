page {
  background: var(--bg-page);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== 头部 ========== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  padding-top: calc(env(safe-area-inset-top) + var(--spacing-md));
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-hover);
  border-radius: 50%;
}

.back-icon {
  font-size: 36rpx;
  color: var(--text-primary);
}

.header-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.header-right {
  width: 72rpx;
}

/* ========== 头像区域 ========== */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) var(--spacing-lg);
  background: var(--bg-card);
  margin-bottom: var(--spacing-md);
}

.avatar-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--bg-hover);
  border: 4rpx solid var(--primary-20);
  box-shadow: var(--shadow-md);
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary-color) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--primary-20);
  box-shadow: var(--shadow-md);
}

.avatar-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 48rpx;
  height: 48rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--bg-card);
}

.avatar-edit-icon {
  font-size: 20rpx;
}

.avatar-tip {
  margin-top: var(--spacing-md);
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

/* ========== 表单区域 ========== */
.form-section {
  margin-bottom: var(--spacing-md);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--spacing-lg);
  margin-bottom: var(--spacing-sm);
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-secondary);
}

.section-tip {
  font-size: var(--font-xs);
  font-weight: 500;
  color: var(--primary-color);
}

.section-link {
  font-size: var(--font-md);
  color: var(--primary-color);
}

.address-entry {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.entry-icon {
  font-size: 40rpx;
}

.entry-text {
  flex: 1;
  font-size: var(--font-lg);
  color: var(--text-primary);
}

.entry-arrow {
  font-size: 40rpx;
  color: var(--text-placeholder);
}

.form-card {
  background: var(--bg-card);
  padding: 0 var(--spacing-lg);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: var(--font-md);
  color: var(--text-secondary);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  text-align: right;
}

.form-input::placeholder {
  color: var(--text-disabled);
}

.form-value {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  text-align: right;
}

.form-value.disabled {
  color: var(--text-disabled);
}

.form-tag {
  font-size: var(--font-xs);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}

.form-tag.admin {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #92400e;
}

.form-tag.user {
  background: var(--primary-bg);
  color: var(--primary-dark);
}

.form-tag.active {
  background: var(--success-bg);
  color: var(--success-text);
}

.form-tag.inactive {
  background: var(--error-bg);
  color: var(--error-text);
}

/* ========== 认证提示 ========== */
.auth-tip {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--primary-bg);
  margin: var(--spacing-sm) var(--spacing-lg) 0;
  border-radius: var(--radius-md);
}

.auth-tip-icon {
  font-size: var(--font-lg);
  flex-shrink: 0;
}

.auth-tip-text {
  font-size: var(--font-xs);
  color: var(--primary-dark);
  line-height: 1.5;
}

/* ========== 保存按钮 ========== */
.save-section {
  padding: var(--spacing-xl) var(--spacing-lg);
}

.btn-save {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  color: #fff;
  border-radius: var(--radius-xl);
  font-size: var(--font-lg);
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-primary);
}

.btn-save[disabled] {
  opacity: 0.6;
}

/* ========== 底部安全区域 ========== */
.bottom-safe {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}
