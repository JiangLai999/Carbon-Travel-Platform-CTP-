<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <text class="header-title">绿色社区</text>
      <text class="header-subtitle">分享低碳生活</text>
    </view>
  </view>

  <!-- 搜索 -->
  <view class="search-section">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索帖子" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
    </view>
  </view>

  <!-- 分类标签 -->
  <view class="tabs">
    <scroll-view scroll-x class="tabs-scroll" enhanced show-scrollbar="{{false}}">
      <view class="tab-item {{selectedTab === index ? 'active' : ''}}" wx:for="{{sections}}" wx:key="id" bindtap="selectTab" data-idx="{{index}}">
        <text>{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 帖子列表 -->
  <scroll-view scroll-y class="scroll-content" enhanced show-scrollbar="{{false}}">
    <view class="posts-feed">
      <view class="post-card" wx:for="{{posts}}" wx:key="id" bindtap="goPostDetail" data-id="{{item.id}}">
        <view class="post-header">
          <view class="author-info">
            <view class="author-avatar" wx:if="{{item.authorAvatar}}">
              <image src="{{item.authorAvatar}}" mode="aspectFill" class="avatar-img" />
            </view>
            <view class="author-avatar placeholder" wx:else>
              <text>{{item.authorName ? item.authorName[0] : '匿'}}</text>
            </view>
            <view class="author-detail">
              <text class="author-name">{{item.authorName || '匿名用户'}}</text>
              <text class="post-time">{{item.createdAt}}</text>
            </view>
          </view>
          <view class="post-tag" wx:if="{{item.isTop === 1}}">
            <text>置顶</text>
          </view>
        </view>
        <view class="post-body">
          <text class="post-title">{{item.title}}</text>
          <text class="post-desc" wx:if="{{item.content}}">{{item.content.length > 80 ? item.content.substring(0, 80) + '...' : item.content}}</text>
        </view>
        <image class="post-cover" src="{{item.firstImage}}" mode="aspectFill" wx:if="{{item.firstImage}}" />
        <view class="post-footer">
          <view class="post-stats">
            <view class="stat-item">
              <text class="stat-icon">👁️</text>
              <text class="stat-value">{{item.views || 0}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">❤️</text>
              <text class="stat-value">{{item.likes || 0}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">💬</text>
              <text class="stat-value">{{item.commentsCount || 0}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-card" wx:if="{{posts.length === 0}}">
        <text class="empty-icon">💬</text>
        <text class="empty-title">暂无帖子</text>
        <text class="empty-desc">成为第一个发帖的人吧</text>
      </view>
    </view>

    <view class="bottom-safe"></view>
  </scroll-view>

  <!-- 发帖按钮 -->
  <view class="fab" bindtap="goPost">
    <text class="fab-icon">✏️</text>
    <text class="fab-text">发帖</text>
  </view>
</view>
