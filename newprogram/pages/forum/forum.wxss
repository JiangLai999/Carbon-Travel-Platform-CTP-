page {
  background: var(--bg-page);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== 头部 ========== */
.header {
  position: relative;
  padding-top: env(safe-area-inset-top);
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  border-radius: 0 0 var(--radius-2xl) var(--radius-2xl);
}

.header-content {
  position: relative;
  padding: var(--spacing-lg);
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
}

.header-title {
  font-size: var(--font-3xl);
  font-weight: 800;
  color: #fff;
  display: block;
  margin-bottom: 4rpx;
}

.header-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}

/* ========== 搜索 ========== */
.search-section {
  padding: 0 var(--spacing-lg);
  margin-top: -30rpx;
  position: relative;
  z-index: 1;
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 20rpx var(--spacing-lg);
  gap: var(--spacing-sm);
  box-shadow: var(--shadow-md);
}

.search-icon {
  font-size: var(--font-lg);
}

.search-input {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.search-input::placeholder {
  color: var(--text-disabled);
}

/* ========== 分类标签 ========== */
.tabs {
  padding: var(--spacing-md) 0 8rpx;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 var(--spacing-lg);
}

.tab-item {
  display: inline-block;
  padding: var(--spacing-sm) var(--spacing-lg);
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.tab-item text {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
}

.tab-item.active text {
  color: #fff;
  font-weight: 600;
}

/* ========== 滚动区域 ========== */
.scroll-content {
  flex: 1;
  height: 100vh;
}

/* ========== 帖子列表 ========== */
.posts-feed {
  padding: var(--spacing-md) var(--spacing-lg);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.post-card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.post-card:active {
  transform: scale(0.99);
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.author-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.author-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.author-avatar.placeholder {
  background: linear-gradient(135deg, var(--primary-bg) 0%, var(--primary-bg-light) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.author-avatar.placeholder text {
  font-size: var(--font-sm);
  color: var(--primary-dark);
  font-weight: 600;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.author-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.author-name {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 600;
}

.post-time {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

.post-tag {
  background: linear-gradient(135deg, var(--accent-bg-light) 0%, var(--accent-bg) 100%);
  padding: 6rpx var(--spacing-sm);
  border-radius: var(--radius-sm);
}

.post-tag text {
  font-size: var(--font-xs);
  color: var(--accent-dark);
  font-weight: 600;
}

.post-body {
  margin-bottom: var(--spacing-md);
}

.post-cover {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  margin-top: var(--spacing-sm);
}

.post-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.post-desc {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-footer {
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--border-light);
}

.post-stats {
  display: flex;
  gap: var(--spacing-lg);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-icon {
  font-size: var(--font-xs);
}

.stat-value {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

/* ========== 空状态 ========== */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

/* ========== 发帖按钮 ========== */
.fab {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  right: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  padding: 20rpx 28rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-primary);
  z-index: 100;
}

.fab:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.fab-icon {
  font-size: var(--font-lg);
}

.fab-text {
  font-size: var(--font-md);
  color: #fff;
  font-weight: 600;
}

/* ========== 底部 ========== */
.bottom-safe {
  height: calc(env(safe-area-inset-bottom) + 160rpx);
}
