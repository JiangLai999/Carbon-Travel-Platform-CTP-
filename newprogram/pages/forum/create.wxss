.page {
  padding: var(--spacing-lg);
  background: var(--bg-page);
  min-height: 100vh;
}

.form-section {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
}

.form-item {
  margin-bottom: var(--spacing-lg);
}

.form-label {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
  display: block;
}

.section-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.section-item {
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: 8rpx;
  border: 2rpx solid var(--border-color);
  font-size: var(--font-md);
  color: var(--text-tertiary);
  background: var(--bg-card);
}

.section-item.active {
  border-color: var(--primary-color);
  background: var(--primary-bg);
  color: var(--primary-dark);
}

.title-input {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-light);
}

.content-input {
  width: 100%;
  min-height: 300rpx;
  font-size: var(--font-lg);
  color: var(--text-primary);
  line-height: 1.6;
  padding: var(--spacing-md) 0;
}

.btn-submit {
  margin-top: 48rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: var(--font-xl);
  font-weight: 600;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.remove-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.add-image-btn {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: var(--text-placeholder);
}

.add-text {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}
