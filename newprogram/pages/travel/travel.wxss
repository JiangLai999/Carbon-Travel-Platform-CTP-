page {
  background: var(--bg-page);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== 头部 ========== */
.header {
  position: relative;
  padding-top: env(safe-area-inset-top);
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  border-radius: 0 0 var(--radius-2xl) var(--radius-2xl);
}

.header-content {
  position: relative;
  padding: var(--spacing-lg);
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
}

.header-title {
  font-size: var(--font-3xl);
  font-weight: 800;
  color: #fff;
  display: block;
  margin-bottom: 4rpx;
}

.header-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}

/* ========== 滚动区域 ========== */
.scroll-content {
  flex: 1;
  height: 100vh;
}

/* ========== 区块 ========== */
.section {
  padding: var(--spacing-lg) var(--spacing-lg) 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-sm);
  color: var(--primary-color);
}

.arrow {
  font-size: var(--font-lg);
}

/* ========== 出行方式 ========== */
.mode-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-md);
}

.mode-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-lg) var(--spacing-sm);
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.mode-item:active {
  transform: scale(0.95);
}

.mode-item.active {
  background: linear-gradient(135deg, var(--primary-bg) 0%, var(--primary-bg-light) 100%);
  border-color: var(--primary-color);
  box-shadow: 0 6rpx 20rpx var(--primary-20);
}

.mode-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: var(--bg-hover);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode-item.active .mode-icon-wrap {
  background: var(--primary-15);
}

.mode-emoji {
  font-size: 36rpx;
}

.mode-name {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  font-weight: 500;
}

.mode-item.active .mode-name {
  color: var(--primary-dark);
  font-weight: 700;
}

.mode-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 28rpx;
  height: 28rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 表单 ========== */
.form-card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 8rpx 0;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.form-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-lg);
  gap: var(--spacing-md);
}

.form-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  font-weight: 700;
  flex-shrink: 0;
}

.form-icon.start {
  background: var(--primary-bg);
  color: var(--success-text);
}

.form-icon.end {
  background: var(--error-bg);
  color: var(--error-text);
}

.form-icon.distance {
  background: #e0e7ff;
  font-size: var(--font-md);
}

.form-connector {
  width: 2rpx;
  height: 24rpx;
  background: linear-gradient(180deg, var(--success-text) 0%, var(--error-text) 100%);
  margin-left: 48rpx;
}

.form-input {
  flex: 1;
  font-size: var(--font-lg);
  color: var(--text-primary);
}

.form-input::placeholder {
  color: var(--text-disabled);
}

.form-unit {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
  font-weight: 500;
}

.form-divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 0 var(--spacing-lg);
}

/* ========== 预计收益 ========== */
.preview-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(135deg, var(--primary-bg) 0%, var(--primary-bg-light) 100%);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-top: var(--spacing-md);
  border: 1rpx solid var(--primary-bg-lighter);
}

.preview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.preview-label {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.preview-value {
  font-size: var(--font-2xl);
  font-weight: 800;
}

.preview-value.carbon {
  color: var(--success-text);
}

.preview-value.points {
  color: var(--accent-color);
}

.preview-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--primary-bg-lighter);
}

/* ========== 按钮 ========== */
.button-group {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-lg);
}

.btn-primary {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  color: #fff;
  border-radius: var(--radius-xl);
  font-size: var(--font-lg);
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 96rpx;
  background: var(--bg-card);
  color: var(--primary-color);
  border-radius: var(--radius-xl);
  font-size: var(--font-md);
  font-weight: 600;
  border: 2rpx solid var(--primary-color);
  box-shadow: var(--shadow-sm);
}

.btn-secondary:active {
  background: var(--primary-bg);
}

.btn-icon {
  font-size: var(--font-lg);
}

/* ========== 记录列表 ========== */
.record-list {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg);
  border-bottom: 1rpx solid var(--border-lighter);
}

.record-item:last-child {
  border-bottom: none;
}

.record-item:active {
  background: var(--bg-hover);
}

.record-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex: 1;
  min-width: 0;
}

.record-mode-icon {
  width: 56rpx;
  height: 56rpx;
  background: var(--primary-bg);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--primary-color);
  font-weight: 600;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-route {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.route-text {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 120rpx;
}

.route-arrow {
  font-size: var(--font-xs);
  color: var(--primary-color);
}

.record-time {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.status-badge {
  font-size: var(--font-xs);
  padding: 6rpx var(--spacing-sm);
  border-radius: var(--radius-sm);
  font-weight: 600;
}

.status-badge.approved {
  background: var(--success-bg);
  color: var(--success-text);
}

.status-badge.rejected {
  background: var(--error-bg);
  color: var(--error-text);
}

.status-badge.pending {
  background: var(--warning-bg);
  color: var(--warning-text);
}

.record-points {
  font-size: var(--font-xs);
  color: var(--accent-color);
  font-weight: 600;
}

/* ========== 空状态 ========== */
.empty-card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: var(--spacing-md);
}

.empty-text {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
}

/* ========== 底部 ========== */
.bottom-safe {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}
