<view class="page">
  <view class="header">
    <text class="header-title">设置</text>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goEditProfile">
      <view class="menu-icon green">
        <text>👤</text>
      </view>
      <text class="menu-label">编辑资料</text>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="clearCache">
      <view class="menu-icon blue">
        <text>🗑️</text>
      </view>
      <text class="menu-label">清除缓存</text>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="goFeedback">
      <view class="menu-icon orange">
        <text>💬</text>
      </view>
      <text class="menu-label">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="goAbout">
      <view class="menu-icon gray">
        <text>ℹ️</text>
      </view>
      <text class="menu-label">关于</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="logout-btn" bindtap="onLogout" style="height: 48rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">退出登录</button>
  </view>

  <view class="version-info">
    <text>版本: {{version}}</text>
  </view>
</view>
