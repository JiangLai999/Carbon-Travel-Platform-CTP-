<view class="page">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="bg-circle circle-1"></view>
    <view class="bg-circle circle-2"></view>
  </view>

  <!-- 头部 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
  </view>

  <!-- Hero区域 -->
  <view class="hero-section">
    <view class="hero-icon-wrap">
      <text class="hero-icon">🌍</text>
    </view>
    <text class="hero-title">欢迎回来</text>
    <text class="hero-subtitle">登录开启绿色低碳之旅</text>
  </view>

  <!-- 登录方式切换 -->
  <view class="tab-bar">
    <view class="tab-item {{loginType === 'password' ? 'active' : ''}}" bindtap="switchTab" data-type="password">
      <text>密码登录</text>
    </view>
    <view class="tab-item {{loginType === 'code' ? 'active' : ''}}" bindtap="switchTab" data-type="code">
      <text>验证码登录</text>
    </view>
    <view class="tab-indicator" style="left: {{loginType === 'password' ? '0' : '50%'}}"></view>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <view class="form-group">
      <view class="input-wrap">
        <text class="input-icon">📱</text>
        <input class="input-field" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onInput" data-field="phone" maxlength="11" />
      </view>
    </view>

    <!-- 密码登录 -->
    <view class="form-group" wx:if="{{loginType === 'password'}}">
      <view class="input-wrap">
        <text class="input-icon">🔒</text>
        <input class="input-field" type="{{showPassword ? 'text' : 'password'}}" placeholder="请输入密码" value="{{password}}" bindinput="onInput" data-field="password" />
        <text class="eye-btn" bindtap="togglePassword">{{showPassword ? '🙈' : '👁️'}}</text>
      </view>
    </view>

    <!-- 验证码登录 -->
    <view class="form-group" wx:if="{{loginType === 'code'}}">
      <view class="input-wrap">
        <text class="input-icon">✉️</text>
        <input class="input-field" type="number" placeholder="请输入6位验证码" value="{{code}}" bindinput="onInput" data-field="code" maxlength="6" />
        <text class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
      </view>
    </view>

    <button class="btn-login" bindtap="handleLogin" loading="{{loading}}">
      <text>登 录</text>
    </button>

    <view class="footer-links">
      <text class="link-text" bindtap="goRegister">立即注册</text>
      <text class="link-divider">|</text>
      <text class="link-text" bindtap="goReset">忘记密码</text>
    </view>
  </view>

  <!-- 底部协议 -->
  <view class="agreement">
    <text class="agreement-text">登录即表示同意</text>
    <text class="agreement-link">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link">《隐私政策》</text>
  </view>
</view>
