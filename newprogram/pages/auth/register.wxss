page {
  background: var(--bg-card);
}

.page {
  min-height: 100vh;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin-left: -12rpx;
  cursor: pointer;
}

.back-btn:active {
  background: transparent;
  opacity: 0.6;
}

.back-icon {
  font-size: 40rpx;
  color: var(--primary-color);
  line-height: 1;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.header-spacer {
  width: 72rpx;
}

/* Hero */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-md);
}

.hero-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  background: var(--primary-10);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
}

.hero-icon {
  font-size: 52rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: var(--font-sm);
  color: var(--text-placeholder);
  display: block;
  text-align: center;
}

/* 容器 */
.container {
  flex: 1;
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
}

/* 表单 */
.form-wrapper {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: var(--spacing-lg);
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.form-label {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-secondary);
  display: block;
}

.input-box {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: 0 20rpx;
  height: 96rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
}

.input-box:focus-within {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3rpx var(--primary-10);
}

.input-icon {
  font-size: var(--font-xl);
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: var(--font-lg);
  color: var(--text-primary);
  background: transparent;
  height: 100%;
}

.input-field::placeholder {
  color: var(--text-disabled);
}

/* 验证码按钮 */
.code-btn {
  flex-shrink: 0;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--primary-color);
  white-space: nowrap;
  padding: 0 8rpx;
}

.code-btn.disabled {
  color: var(--text-placeholder);
}

/* 注册按钮 */
.btn-register {
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  color: #fff;
  border-radius: var(--radius-sm);
  font-size: var(--font-xl);
  font-weight: 700;
  border: none;
  margin-top: 8rpx;
  box-shadow: var(--shadow-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-register:active {
  opacity: 0.9;
}

.btn-text {
  letter-spacing: 2rpx;
}

/* 协议 */
.agreement-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
  padding: var(--spacing-md) 0 32rpx;
}

.tip-text {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

.tip-link {
  font-size: var(--font-xs);
  color: var(--primary-color);
}
