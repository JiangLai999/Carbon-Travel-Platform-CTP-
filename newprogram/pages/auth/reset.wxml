<view class="page">
  <view class="header">
    <view class="back-btn" bindtap="goLogin">
      <text class="back-icon">←</text>
    </view>
    <text class="header-title">重置密码</text>
    <view class="header-spacer"></view>
  </view>

  <view class="container">
    <view class="form-wrapper">
      <view class="form-group">
        <text class="form-label">手机号码</text>
        <view class="input-box">
          <text class="input-icon">📱</text>
          <input class="input-field" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onInput" data-field="phone" placeholder-style="color: #d1d5db" maxlength="11" />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">验证码</text>
        <view class="input-box">
          <text class="input-icon">🔢</text>
          <input class="input-field" type="number" placeholder="请输入6位验证码" value="{{code}}" bindinput="onInput" data-field="code" placeholder-style="color: #d1d5db" maxlength="6" />
          <text class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">新密码</text>
        <view class="input-box">
          <text class="input-icon">🔐</text>
          <input class="input-field" type="password" placeholder="请输入新密码（至少6位）" value="{{newPassword}}" bindinput="onInput" data-field="newPassword" placeholder-style="color: #d1d5db" />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">确认密码</text>
        <view class="input-box">
          <text class="input-icon">🔐</text>
          <input class="input-field" type="password" placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="onInput" data-field="confirmPassword" placeholder-style="color: #d1d5db" />
        </view>
      </view>

      <button class="btn-reset" bindtap="handleReset" loading="{{loading}}">
        <text class="btn-text">确认重置</text>
      </button>
    </view>

    <view class="tips">
      <text class="tip-icon">💡</text>
      <text class="tip-text">密码需要 6 位以上，建议使用字母和数字组合</text>
    </view>
  </view>
</view>
