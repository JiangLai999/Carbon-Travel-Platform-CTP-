<view class="page" wx:if="{{product}}">
  <view class="product-image" style="background-image: url('{{product.imageUrl}}')">
    <view class="badge" wx:if="{{product.carbonLabel}}">{{product.carbonLabel}}</view>
  </view>
  
  <view class="product-info">
    <text class="product-name">{{product.name}}</text>
    <view class="points-row">
      <text class="points-value">{{product.pointsRequired}}</text>
      <text class="points-label">积分</text>
    </view>
    <view class="meta-row">
      <text class="stock">库存: {{product.stock}}件</text>
      <text class="category" wx:if="{{product.categoryName}}">{{product.categoryName}}</text>
    </view>
    <text class="product-desc">{{product.description}}</text>
  </view>

  <view class="detail-section">
    <text class="section-title">商品详情</text>
    <view class="detail-content">
      <view class="detail-item">
        <text class="detail-label">兑换方式</text>
        <text class="detail-value">纯积分兑换</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">配送方式</text>
        <text class="detail-value">免费包邮</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">预计发货</text>
        <text class="detail-value">兑换后3个工作日内</text>
      </view>
    </view>
  </view>

  <view class="carbon-tip">
    <text class="tip-icon">🌱</text>
    <text class="tip-text">兑换此商品可减少碳排放，为环保贡献力量</text>
  </view>

  <!-- 收货地址选择 -->
  <view class="address-section">
    <text class="section-title">收货地址</text>
    <view class="address-card" bindtap="selectAddress">
      <view class="address-info" wx:if="{{hasAddress && selectedAddress}}">
        <text class="address-detail">{{selectedAddress}}</text>
      </view>
      <view class="address-empty" wx:else>
        <text class="address-empty-text">请选择收货地址</text>
      </view>
      <text class="address-arrow">›</text>
    </view>
    <view class="address-tip">点击选择已保存地址或新增地址</view>
  </view>

  <!-- 地址填写弹窗 -->
  <view class="address-modal-mask" wx:if="{{showAddressModal}}" bindtap="closeAddressModal"></view>
  <view class="address-modal" wx:if="{{showAddressModal}}">
    <view class="modal-header">
      <text class="modal-title">新增收货地址</text>
      <text class="modal-close" bindtap="closeAddressModal">✕</text>
    </view>
    <scroll-view scroll-y class="modal-content">
      <view class="form-group">
        <text class="form-label">收货人</text>
        <input class="form-input" placeholder="请输入收货人姓名" value="{{addressForm.name}}" bindinput="onAddressInput" data-field="name" />
      </view>
      <view class="form-group">
        <text class="form-label">手机号</text>
        <input class="form-input" placeholder="请输入联系电话" value="{{addressForm.phone}}" bindinput="onAddressInput" data-field="phone" type="number" maxlength="11" />
      </view>
      <view class="form-group">
        <text class="form-label">省份</text>
        <input class="form-input" placeholder="请输入省份" value="{{addressForm.province}}" bindinput="onAddressInput" data-field="province" />
      </view>
      <view class="form-group">
        <text class="form-label">城市</text>
        <input class="form-input" placeholder="请输入城市" value="{{addressForm.city}}" bindinput="onAddressInput" data-field="city" />
      </view>
      <view class="form-group">
        <text class="form-label">区县</text>
        <input class="form-input" placeholder="请输入区县" value="{{addressForm.district}}" bindinput="onAddressInput" data-field="district" />
      </view>
      <view class="form-group">
        <text class="form-label">详细地址</text>
        <textarea class="form-textarea" placeholder="请输入详细地址，如街道、小区、楼栋、门牌号" value="{{addressForm.detailAddress}}" bindinput="onAddressInput" data-field="detailAddress" />
      </view>
    </scroll-view>
    <view class="modal-footer">
      <button class="btn-save-address" bindtap="saveAddressForm">保存并兑换</button>
      <button class="btn-cancel-address" bindtap="closeAddressModal">取消</button>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="points-cost">
      <text class="cost-label">消耗积分</text>
      <text class="cost-value">{{product.pointsRequired}}</text>
    </view>
    <button class="btn-exchange" bindtap="doExchangeClick" disabled="{{product.stock <= 0}}">
      {{product.stock > 0 ? '立即兑换' : '已售罄'}}
    </button>
  </view>
</view>
